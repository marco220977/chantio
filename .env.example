# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Nom et URL de l'appli ---
NEXT_PUBLIC_APP_NAME=Chantio
NEXT_PUBLIC_APP_URL=https://chantio.vercel.app

# --- Scan plaque chaudière (console.anthropic.com) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Stripe (abonnement des plombiers à ton SaaS) ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Envoi des devis/factures par e-mail (brevo.com, gratuit 300 e-mails/jour) ---
BREVO_API_KEY=xkeysib-...
EMAIL_FROM=adresse-expediteur-verifiee@exemple.fr

# --- Facture électronique (plateforme agréée partenaire) ---
# "simulation" tant qu'aucun partenaire n'est signé ; "generic" + URL/clé une fois le contrat signé
EINVOICE_PROVIDER=simulation
EINVOICE_PROVIDER_NAME=
EINVOICE_API_URL=
EINVOICE_API_KEY=
